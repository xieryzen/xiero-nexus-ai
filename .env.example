# ─── Xiero Nexus AI — environment ──────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

NODE_ENV=development

# Port. On Pterodactyl, map the panel's allocation here, e.g. PORT=$SERVER_PORT
PORT=3000

# Public base URL of this app (used for absolute links, cookies in prod).
APP_URL=http://localhost:3000

# ─── Secrets ────────────────────────────────────────────────────────────────
# 32-byte key (base64) used to encrypt provider API keys and 2FA secrets AT REST.
# Keep this OUTSIDE the database and out of version control.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# Long random string used to derive/sign session identifiers.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path. Migrations are applied automatically on first boot.
DATABASE_PATH=./data/nexus.db

# ─── Bootstrap admin ──────────────────────────────────────────────────────────
# A single admin account is created on first boot ONLY if the users table is empty.
# Change the password immediately after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
