# ─── Xiero Nexus AI — configuration ─────────────────────────────────────────
# Copy this file to `.env` and set SECRET_ENCRYPTION_KEY. NEVER commit `.env`.
# Lines starting with # are off; remove the # to turn a setting on.

# ─── Required ────────────────────────────────────────────────────────────────
# 32 random bytes (base64). Encrypts provider API keys and 2FA secrets at rest.
# Keep it safe and keep it when you upgrade: without this exact key the stored
# provider keys and 2FA secrets cannot be read.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# ─── First administrator ─────────────────────────────────────────────────────
# Created on first start, only while there are no users yet. Set a password to
# use it, then change that password after signing in. Leave the password empty
# to skip this: the first account registered in the browser becomes the admin.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Web address and sign-in cookies ─────────────────────────────────────────
# In production, session cookies are sent over HTTPS only. If people open the
# app over plain http:// (for example http://your-server-ip:port with no HTTPS
# proxy in front), sign-in cannot work until you set COOKIE_SECURE=false.
# Plain HTTP lets anyone on the network path read passwords and sessions, so
# prefer HTTPS.
# COOKIE_SECURE=false

# Public address of the app. Set it to your https:// address when the app sits
# behind an HTTPS proxy that does not pass X-Forwarded-Proto.
# APP_URL=https://nexus.example.com

# ─── Network ─────────────────────────────────────────────────────────────────
# Port to listen on (default 3000). Release bundles (`node start.js`) read it
# from here; on Pterodactyl leave it off — the panel's port is used
# automatically. When running from source (`npm run start`), set PORT in the
# environment instead.
# PORT=3000

# Address to bind in release bundles (default 0.0.0.0 = all interfaces).
# Use 127.0.0.1 when a reverse proxy on the same machine is the only client.
# BIND_HOST=127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite file. Migrations are applied automatically on first start.
# DATABASE_PATH=./data/nexus.db

# ─── Generated images and videos ─────────────────────────────────────────────
# Folder where generated media files are kept. By default it is a "media"
# folder next to the database file (./data/media). Videos take space: point
# this at a larger disk if you need to, and back it up with the database.
# MEDIA_PATH=./data/media

# ─── Providers on private networks ───────────────────────────────────────────
# Provider Base URLs that point at private or loopback addresses are refused.
# List the hosts you trust (comma separated) to allow local model servers or a
# sandbox runner on the same network.
# ALLOW_PRIVATE_PROVIDER_HOSTS=127.0.0.1,ollama.local

# ─── Sandboxed code execution (optional) ─────────────────────────────────────
# Code never runs on this app's host. Execution stays off unless SANDBOX_URL
# points at a separately deployed runner (see sandbox-runner/ in the source).
# SANDBOX_URL=http://sandbox.internal:8080
# SANDBOX_TOKEN=
# SANDBOX_ALLOWED_COMMANDS=node,npm,npx,python3
