# ─── Xiero Nexus AI — configuration ─────────────────────────────────────────
# Copy this file to `.env` and set SECRET_ENCRYPTION_KEY. NEVER commit `.env`.
# Lines starting with # are off; remove the # to turn a setting on.

# ─── Required ────────────────────────────────────────────────────────────────
# 32 random bytes (base64). Encrypts provider API keys and 2FA secrets at rest.
# Keep it safe and keep it when you upgrade: without this exact key the stored
# provider keys and 2FA secrets cannot be read.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# ─── First administrator ─────────────────────────────────────────────────────
# Created on first start, only while there are no users yet. Set a password to
# use it, then change that password after signing in. Leave the password empty
# to skip this: the first account registered in the browser becomes the admin.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Web address and sign-in cookies ─────────────────────────────────────────
# In production, session cookies are sent over HTTPS only. If people open the
# app over plain http:// (for example http://your-server-ip:port with no HTTPS
# proxy in front), sign-in cannot work until you set COOKIE_SECURE=false.
# Plain HTTP lets anyone on the network path read passwords and sessions, so
# prefer HTTPS.
# COOKIE_SECURE=false

# Public address of the app. Links in webhook messages and the file links the
# API returns are built from it, so set it to the address people open. It also
# tells the app that it is served over HTTPS when the proxy in front does not
# pass X-Forwarded-Proto.
# APP_URL=https://nexus.example.com

# ─── Network ─────────────────────────────────────────────────────────────────
# Port to listen on (default 3000). Release bundles (`node start.js`) read it
# from here; on Pterodactyl leave it off — the panel's port is used
# automatically. When running from source (`npm run start`), set PORT in the
# environment instead.
# PORT=3000

# Address to bind in release bundles (default 0.0.0.0 = all interfaces).
# Use 127.0.0.1 when a reverse proxy on the same machine is the only client.
# BIND_HOST=127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite file. Migrations are applied automatically on first start.
# DATABASE_PATH=./data/nexus.db

# ─── Generated images, voice-overs and videos ────────────────────────────────
# Folder where generated media files are kept. By default it is a "media"
# folder next to the database file (./data/media). Videos take space: point
# this at a larger disk if you need to, and back it up with the database.
# MEDIA_PATH=./data/media

# Joining clips into one video is done by ffmpeg on this server. Without
# ffmpeg everything else works, and Creative Studio says what is missing. By
# default the program "ffmpeg" on the PATH is used; name another one here.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Subtitles are drawn with the font that comes with the app (Noto Sans Bold):
# Latin, Greek, Cyrillic and Devanagari. For Arabic, Hebrew, Thai, Chinese,
# Japanese, Korean or another script, name a .ttf or .otf file that has it.
# The font's name is read from the file; set it only if that fails.
# SUBTITLE_FONT_FILE=/usr/share/fonts/truetype/noto/NotoSansArabic-Bold.ttf
# SUBTITLE_FONT_NAME=Noto Sans Arabic

# ─── Background work ─────────────────────────────────────────────────────────
# Project runs, schedules, videos in progress, joining clips and webhooks are
# worked on inside the server, by its background worker. There is nothing to
# start besides the app.
# How many project runs work at the same time (1 to 10, default 3):
# RUN_CONCURRENCY=3
# Switch the worker off, for a second server process on the same database
# that should only answer requests:
# NEXUS_WORKER=0

# ─── A provider that says "not now" ──────────────────────────────────────────
# A request that a model provider answers with 429 (too many requests) is sent
# again: after the wait the provider asks for (up to 90 seconds), or after 3,
# 10, 25 and 45 seconds, two and a half minutes in all at most. One that says
# it is busy (503, 529) is asked again twice. A model that was waited for in
# vain is not waited for again for five minutes, then for longer, until it
# answers. How often a request is sent again (0 to 8, default 4; 0 = never,
# the answer is an error at once):
# PROVIDER_RETRIES=4

# The app checks by itself that its chat models answer, and leaves a model
# that fails out of the model lists until a check passes again. How often a
# working model is checked, in minutes (default 360; 0 = no automatic check):
# MODEL_HEALTH_INTERVAL_MINUTES=360

# ─── Providers on private networks ───────────────────────────────────────────
# Provider Base URLs that point at private or loopback addresses are refused.
# List the hosts you trust (comma separated) to allow local model servers or a
# sandbox runner on the same network.
# ALLOW_PRIVATE_PROVIDER_HOSTS=127.0.0.1,ollama.local

# ─── Sandboxed code execution (optional) ─────────────────────────────────────
# Code never runs on this app's host. Execution stays off unless SANDBOX_URL
# points at a separately deployed runner (see sandbox-runner/ in the source).
# The agent tool "Run commands" needs it too.
# SANDBOX_URL=http://sandbox.internal:8080
# SANDBOX_TOKEN=
# SANDBOX_ALLOWED_COMMANDS=node,npm,npx,python3

# ─── Tools for agents (optional) ─────────────────────────────────────────────
# Web search, for agents that have the tool "Search the web". Choose a search
# service and give its key: brave (api.search.brave.com), tavily (tavily.com),
# or searxng (your own SearXNG; set SEARCH_URL to its /search address, and no
# key is needed).
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY=
# SEARCH_URL=https://searx.example.com/search

# Agents with the tools "Read web pages" and "Call HTTP APIs" can reach any
# public address, and never a private one. To limit them to certain hosts
# (their subdomains included), list those here:
# AGENT_HTTP_ALLOWED_HOSTS=api.example.com,docs.example.com
# Hosts on a private network that agents may reach all the same:
# AGENT_HTTP_PRIVATE_HOSTS=intranet.example.com

# ─── Webhooks to private networks ────────────────────────────────────────────
# A notification webhook that points at a private or loopback address is
# refused. List the hosts you trust (comma separated) to allow them.
# ALLOW_PRIVATE_WEBHOOK_HOSTS=chat.internal
