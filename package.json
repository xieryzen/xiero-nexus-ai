{
  "name": "xiero-nexus-ai",
  "version": "1.4.0",
  "private": true,
  "description": "Xiero Nexus AI — configurable multi-provider AI platform. One Command. Infinite Intelligence.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "NEXT_OUTPUT=standalone next build",
    "start": "next start -p ${PORT:-3000}",
    "package": "bash scripts/package-release.sh",
    "package:test": "bash scripts/smoke-test-bundle.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e/run.mjs",
    "release:info": "node scripts/release-info.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:alpha": "npm version prerelease --preid=alpha --no-git-tag-version",
    "version:beta": "npm version prerelease --preid=beta --no-git-tag-version",
    "version:rc": "npm version prerelease --preid=rc --no-git-tag-version"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.1",
    "next": "^14.2.15",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
